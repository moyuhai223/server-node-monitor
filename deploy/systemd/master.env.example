# /etc/snm-master/master.env  (chmod 600 root:root)
# Friendly SNM_* variables map onto the "Snm" configuration section (docs/DEPLOY.md 6).
SNM_LISTEN=http://127.0.0.1:5080
SNM_DATA_DIR=/var/lib/snm-master
SNM_PUBLIC_BASE_URL=https://m.example.com
SNM_KNOWN_PROXIES=127.0.0.1,::1
# Docker / remote reverse proxy networks (CIDR, comma separated)
# SNM_KNOWN_NETWORKS=172.16.0.0/12

# Initial admin account (used on the first start only; remove the password afterwards)
SNM_ADMIN_USER=admin
SNM_ADMIN_PASSWORD=ChangeMe-Now-2026!

# Optional
# SNM_JWT_SECRET=<64+ random characters; generated and stored in the database when empty>
# SNM_TIMEZONE=Asia/Shanghai
# SNM_LOG_LEVEL=Information
# SNM_GEOIP_ENABLED=true
# SNM_GEOIP_BASE_URL=https://cdn.jsdelivr.net/npm/@ip-location-db/asn-country

ASPNETCORE_ENVIRONMENT=Production
DOTNET_gcServer=0
DOTNET_GCHeapHardLimit=0x20000000
